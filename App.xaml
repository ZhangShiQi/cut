<Application x:Class="Cut.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Background" Value="#EFF4F9" />
      <Setter Property="BorderBrush" Value="#DCE4ED" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Application.Resources>
</Application>

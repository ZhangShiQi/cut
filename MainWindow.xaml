<Window x:Class="Cut.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cut · 轻巧截图" Icon="Assets/Cut.ico" Width="580" Height="610" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="#F5F7FB" FontFamily="Microsoft YaHei UI" FontSize="14">
  <Grid Margin="32">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Cut" FontSize="36" FontWeight="Bold" Foreground="#12243A"/>
      <TextBlock Text="框住此刻，随手分享。" Foreground="#65758A" Margin="0,5,0,24"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="22">
      <StackPanel>
        <TextBlock Text="截图快捷键" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Margin="0,18,0,12" VerticalAlignment="Center">
          <CheckBox x:Name="CtrlCheck" Content="Ctrl" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <CheckBox x:Name="AltCheck" Content="Alt" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <CheckBox x:Name="ShiftCheck" Content="Shift" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <ComboBox x:Name="KeyChoice" Width="60" Height="30" VerticalContentAlignment="Center"/>
          <Button Content="应用" Click="ApplyHotkey" Padding="12,5"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Foreground="#197B68" TextWrapping="Wrap" FontSize="12" MinHeight="36"/>
        <Separator Margin="0,8,0,15" Background="#E9EDF3"/>
        <TextBlock Text="单击选中鼠标下的窗口，也可拖拽自由框选。" Foreground="#65758A" FontSize="13"/>
        <TextBlock Text="Enter 复制  ·  Ctrl + S 保存  ·  Esc 取消" Foreground="#65758A" FontSize="13" Margin="0,8,0,0"/>
        <TextBlock Text="Ctrl + Q 识别选区内的二维码" Foreground="#197B68" FontSize="13" Margin="0,8,0,0"/>
        <TextBlock Text="Ctrl + T 识别文字 · 支持中英文混排" Foreground="#197B68" FontSize="13" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2" Margin="0,20,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="关闭窗口后仍在托盘运行" Foreground="#7B899B" FontSize="12"/>
        <Button Content="翻译服务设置" Click="OpenTranslationSettings" HorizontalAlignment="Left" Padding="10,5" Margin="0,8,0,0"/>
      </StackPanel>
      <Button Grid.Column="1" Content="开始截图" Click="StartCapture" Background="#197B68" Foreground="White" BorderThickness="0" Padding="24,11"/>
    </Grid>
  </Grid>
</Window>

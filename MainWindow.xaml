<Window x:Class="Cut.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cut · 轻巧截图" Icon="Assets/Cut.ico" Width="580" Height="700" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="#F5F7FB" FontFamily="Microsoft YaHei UI" FontSize="14">
  <Grid Margin="32">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Cut" FontSize="36" FontWeight="Bold" Foreground="#12243A"/>
      <TextBlock Text="框住此刻，随手分享。" Foreground="#65758A" Margin="0,5,0,24"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="22">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="截图快捷键" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Margin="0,18,0,12" VerticalAlignment="Center">
          <CheckBox x:Name="CtrlCheck" Content="Ctrl" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <CheckBox x:Name="AltCheck" Content="Alt" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <CheckBox x:Name="ShiftCheck" Content="Shift" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <ComboBox x:Name="KeyChoice" Width="60" Height="30" VerticalContentAlignment="Center"/>
          <Button Content="应用" Click="ApplyHotkey" Padding="12,5"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Foreground="#197B68" TextWrapping="Wrap" FontSize="12" MinHeight="36"/>
        <Separator Margin="0,8,0,15" Background="#E9EDF3"/>
        <CheckBox x:Name="StartupCheck" Content="开机自动启动" Checked="ChangeStartup" Unchecked="ChangeStartup"/>
        <TextBlock x:Name="StartupStatus" Foreground="#65758A" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" MinHeight="36"/>
        <Separator Margin="0,8,0,15" Background="#E9EDF3"/>
        <TextBlock Text="单击选中鼠标下的窗口，也可拖拽自由框选。" Foreground="#65758A" FontSize="13"/>
        <TextBlock Text="Enter 复制  ·  Ctrl + S 保存  ·  Esc 取消" Foreground="#65758A" FontSize="13" Margin="0,8,0,0"/>
        <TextBlock Text="Ctrl + Q 识别选区内的二维码" Foreground="#197B68" FontSize="13" Margin="0,8,0,0"/>
        <TextBlock Text="Ctrl + T 识别文字 · 支持中英文混排" Foreground="#197B68" FontSize="13" Margin="0,8,0,0"/>
        <TextBlock Text="Ctrl + I AI 看图 · 界面、图表与报错分析" Foreground="#197B68" FontSize="13" Margin="0,8,0,0"/>
        <StackPanel x:Name="UpdatePanel" Margin="0,18,0,0">
          <Separator Margin="0,0,0,15" Background="#E9EDF3"/>
          <TextBlock Text="版本与更新" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding CurrentVersion}" Margin="0,8,0,8"/>
          <CheckBox x:Name="AutoUpdateCheck" Content="自动检查并下载正式版本" IsChecked="{Binding Automatic, Mode=OneWay}" Click="ChangeAutomaticUpdate"/>
          <TextBlock Text="{Binding Status}" Foreground="#197B68" TextWrapping="Wrap" Margin="0,10,0,5"/>
          <TextBlock Text="{Binding Details}" Foreground="#65758A" FontSize="12" TextWrapping="Wrap"/>
          <WrapPanel Margin="0,10,0,5">
            <Button Content="检查更新" Click="CheckUpdates" IsEnabled="{Binding CanCheck}" Padding="10,5" Margin="0,0,6,5"/>
            <Button Content="取消下载" Click="CancelUpdate" IsEnabled="{Binding CanCancel}" Padding="10,5" Margin="0,0,6,5"/>
            <Button Content="重启并更新" Click="InstallUpdate" IsEnabled="{Binding CanInstall}" Padding="10,5" Margin="0,0,0,5"/>
          </WrapPanel>
          <TextBox Text="{Binding ReleaseNotes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
          <Expander Header="私有更新仓库访问（可选）" Margin="0,8,0,0" FontSize="12">
            <StackPanel Margin="0,8,0,0">
              <TextBlock Text="填写具有发行仓库 Contents 读取权限的个人令牌，仅加密保存到当前 Windows 用户。公开仓库无需填写。" TextWrapping="Wrap" Foreground="#65758A"/>
              <PasswordBox x:Name="ReleaseToken" Margin="0,8,0,5" MaxLength="4096"/>
              <Button Content="保存令牌（留空则清除）" Click="SaveReleaseToken" Padding="10,5" HorizontalAlignment="Left"/>
            </StackPanel>
          </Expander>
        </StackPanel>
      </StackPanel>
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="2" Margin="0,20,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="关闭窗口后仍在托盘运行" Foreground="#7B899B" FontSize="12"/>
        <WrapPanel>
          <Button Content="翻译服务设置" Click="OpenTranslationSettings" Padding="10,5" Margin="0,8,6,0"/>
          <Button Content="AI 模型设置" Click="OpenAiSettings" Padding="10,5" Margin="0,8,0,0"/>
          <Button Content="视觉模型设置" Click="OpenVisionSettings" Padding="10,5" Margin="6,8,0,0"/>
        </WrapPanel>
      </StackPanel>
      <Button Grid.Column="1" Content="开始截图" Click="StartCapture" Background="#197B68" Foreground="White" BorderThickness="0" Padding="24,11"/>
    </Grid>
  </Grid>
</Window>

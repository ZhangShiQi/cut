<UserControl x:Class="Cut.AiAssistantPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <WrapPanel>
        <ComboBox x:Name="ModeBox" Width="126" Height="32" Margin="0,4,8,4" VerticalContentAlignment="Center" SelectionChanged="OptionsChanged">
          <ComboBoxItem Content="读懂截图文字" IsSelected="True"/><ComboBoxItem Content="解释报错"/><ComboBoxItem Content="总结重点"/><ComboBoxItem Content="润色文字"/><ComboBoxItem Content="自定义提问"/>
        </ComboBox>
        <ComboBox x:Name="ScopeBox" Width="100" Height="32" Margin="0,4,8,4" VerticalContentAlignment="Center" SelectionChanged="OptionsChanged">
          <ComboBoxItem Content="全部原文" IsSelected="True"/><ComboBoxItem Content="选中文字"/>
        </ComboBox>
        <Button x:Name="SettingsButton" Content="模型设置" Click="SettingsClick" Padding="10,5"/>
      </WrapPanel>
      <TextBlock Text="仅分析提取的文字，不上传截图。点击生成才发送；AI 回答请核对。" FontSize="12" TextWrapping="Wrap" Foreground="#65758A" Margin="0,4,0,8"/>
    </StackPanel>
    <TextBox x:Name="QuestionText" Grid.Row="1" Visibility="Collapsed" Height="64" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" Margin="0,0,0,8" TextChanged="QuestionChanged" ToolTip="输入你想针对原文询问的问题，最多 2,000 字符"/>
    <Grid Grid.Row="2" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="GenerateButton" Content="生成回答" Click="GenerateClick" Background="#197B68" Foreground="White" Padding="12,7" Margin="0,0,6,0"/>
      <Button x:Name="StopButton" Grid.Column="1" Content="停止" Click="StopClick" Padding="10,7" Margin="0,0,8,0" IsEnabled="False"/>
      <TextBlock x:Name="StateText" Grid.Column="2" Text="可在左侧校对原文后生成。" FontSize="12" Foreground="#65758A" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </Grid>
    <TextBox x:Name="AnswerText" Grid.Row="3" AcceptsReturn="True" AcceptsTab="True" IsUndoEnabled="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" BorderBrush="#ABD4C8" Foreground="#12243A" Background="White" TextChanged="AnswerChanged" SelectionChanged="AnswerSelectionChanged"/>
    <WrapPanel Grid.Row="4" Margin="0,8,0,0">
      <Button x:Name="CopySelectedButton" Content="复制选中" Click="CopySelectedClick" Padding="10,7"/>
      <Button x:Name="CopyAllButton" Content="复制回答并完成" Click="CopyAllClick" ToolTip="回答框内 Ctrl + Enter" Padding="10,7"/>
    </WrapPanel>
  </Grid>
</UserControl>

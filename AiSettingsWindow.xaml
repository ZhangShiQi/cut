<Window x:Class="Cut.AiSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cut · 模型服务设置" Icon="Assets/Cut.ico" Width="650" Height="620" MinWidth="520" MinHeight="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True" Background="#F5F7FB" FontFamily="Microsoft YaHei UI" FontSize="14">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="SettingsFields">
        <TextBlock Text="模型服务设置" FontSize="24" FontWeight="SemiBold" Foreground="#12243A"/>
        <TextBlock Text="接入兼容 Chat Completions 的模型服务。配置与翻译服务独立，填写服务商提供的模型名称和 API Key。" TextWrapping="Wrap" Foreground="#65758A" Margin="0,12,0,16"/>
        <TextBlock Text="完整接口地址"/>
        <TextBox x:Name="EndpointText" Padding="10" Margin="0,6,0,4"/>
        <TextBlock Text="填写到 /chat/completions，包含服务商要求的路径前缀。远程地址须为 HTTPS；本机服务可使用 http://localhost。" FontSize="12" TextWrapping="Wrap" Foreground="#65758A"/>
        <TextBlock Text="模型名称" Margin="0,16,0,0"/>
        <TextBox x:Name="ModelText" Padding="10" Margin="0,6,0,0"/>
        <TextBlock Text="填写该服务账户可用的模型 ID，软件不会自动选择或切换模型。" FontSize="12" TextWrapping="Wrap" Foreground="#65758A" Margin="0,4,0,0"/>
        <TextBlock Text="API Key（本机免鉴权服务可留空）" Margin="0,16,0,0"/>
        <PasswordBox x:Name="KeyText" Padding="10" Margin="0,6,0,0"/>
        <TextBlock Text="密钥使用当前 Windows 用户加密保存。点击生成才发送所选文字及问题，不发送截图；服务可能按用量收费。测试连接只发送固定示例，测试成功后仍需点击保存。" TextWrapping="Wrap" FontSize="12" Foreground="#65758A" Margin="0,16,0,8"/>
      </StackPanel>
    </ScrollViewer>
    <TextBlock x:Name="StatusText" Grid.Row="1" Text="保存后可在文字识别窗口的“AI 助手”中使用。" Foreground="#197B68" TextWrapping="Wrap" Margin="0,16,0,8"/>
    <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
      <Button x:Name="TestButton" Content="测试连接" Click="TestClick"/>
      <Button x:Name="SaveButton" Content="保存" Click="SaveClick" Background="#197B68" Foreground="White"/>
      <Button Content="取消" Click="CancelClick"/>
    </WrapPanel>
  </Grid>
</Window>

<Window x:Class="Cut.OcrResultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cut · 文字识别结果" Icon="Assets/Cut.ico" Width="960" Height="620" MinWidth="720" MinHeight="450" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True" Background="#F5F7FB" FontFamily="Microsoft YaHei UI" FontSize="14">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="文字识别结果" FontSize="24" FontWeight="SemiBold" Foreground="#12243A"/>
      <TextBlock x:Name="SummaryText" Margin="0,8,0,0" Foreground="#65758A" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="#DCE4ED" BorderThickness="1" Padding="12">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="原始截图 · 可滚动查看" Foreground="#65758A" FontSize="12" Margin="0,0,0,10"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Image x:Name="PreviewImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          </ScrollViewer>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="可直接编辑 · Ctrl + C 复制选中文字" Foreground="#65758A" FontSize="12" Margin="0,0,0,10"/>
        <TextBox x:Name="ContentText" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" IsUndoEnabled="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="14" BorderBrush="#DCE4ED" Foreground="#12243A" Background="White" SelectionChanged="SelectionChanged" TextChanged="TextChanged"/>
      </Grid>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="2" Text="请核对识别结果；返回选区后可重新框选。" Foreground="#65758A" Margin="0,12,0,8" TextWrapping="Wrap"/>
    <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
      <Button Content="返回选区" Click="BackClick"/>
      <Button x:Name="MergeButton" Content="合并换行" ToolTip="合并当前文本的换行，可按 Ctrl + Z 撤销" Click="MergeClick"/>
      <Button x:Name="CopySelectionButton" Content="复制选中" Click="CopySelectionClick"/>
      <Button x:Name="CopyAllButton" Content="复制全部并完成" ToolTip="Ctrl + Enter" Click="CopyAllClick" Background="#197B68" Foreground="White" BorderThickness="0"/>
    </WrapPanel>
  </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Cut</AssemblyName>
    <RootNamespace>Cut</RootNamespace>
    <Version>0.4.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\Cut.ico</ApplicationIcon>
    <!-- WPF owns application startup; WinForms is used only for the tray icon.
         DPI awareness must be established by the manifest before any HWND exists. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win.slim" Version="4.13.0.20260627" />
    <None Update="Models\*.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Models\manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\Cut.ico" />
    <Resource Include="Assets\Cut.Tray.ico" />
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Licenses\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckOcrModels" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('Models\ch_PP-OCRv5_det_mobile.onnx') Or !Exists('Models\ch_PP-OCRv5_rec_mobile.onnx')" Text="缺少 OCR 模型，请先运行 powershell -File Tools\download-ocr-models.ps1" />
  </Target>
</Project>

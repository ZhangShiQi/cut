<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Cut</AssemblyName>
    <RootNamespace>Cut</RootNamespace>
    <Version>0.2.0</Version>
    <!-- WPF owns application startup; WinForms is used only for the tray icon.
         DPI awareness must be established by the manifest before any HWND exists. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Licenses\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
